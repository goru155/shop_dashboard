rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'admin@shop.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower().matches('.*admin.*')) ||
        request.auth.token.admin == true
      );
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['orderId', 'orderStatus', 'customer', 'items', 'pricing'])
        && request.resource.data.orderStatus == 'new'
        && request.resource.data.customer is map
        && (
          request.resource.data.customer.email == request.auth.token.email ||
          (request.auth.token.email != null && request.resource.data.customer.email.lower() == request.auth.token.email.lower())
        )
        && request.resource.data.items is list
        && request.resource.data.pricing is map;
      allow read: if isAdmin() || (signedIn() && (
        resource.data.customer.email == request.auth.token.email ||
        (request.auth.token.email != null && resource.data.customer.email.lower() == request.auth.token.email.lower())
      ));
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow get, list: if isAdmin()
        || (signedIn() && (
          resource.data.email == request.auth.token.email ||
          (request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        ));
      allow create, update: if isAdmin()
        || (signedIn() && (
          request.auth.uid == customerId ||
          request.resource.data.email == request.auth.token.email ||
          (request.auth.token.email != null && request.resource.data.email.lower() == request.auth.token.email.lower())
        ));
      allow delete: if isAdmin();

      match /ledger/{entryId} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}